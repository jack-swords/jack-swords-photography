# Sanity project (create one at https://www.sanity.io/manage or with `pnpm dlx sanity init --bare`)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01

# Public site URL (used for metadata, sitemap and Studio previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only tokens (Manage → API → Tokens). Never prefix these with NEXT_PUBLIC_.
# Viewer token: draft mode / visual editing (milestone 5)
SANITY_API_READ_TOKEN=
# Editor token: seed + import scripts, programmatic updates
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity → Next.js revalidation webhook (milestone 5)
SANITY_REVALIDATE_SECRET=
